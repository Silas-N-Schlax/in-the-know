- round = game.current_round
.round-outcome class="round-outcome--#{round.winner}"
  - if round.last_vote_outcome
    = render 'host/games/vote_result', game:
  p.round-outcome__winner = round.won_by_insiders? ? 'Insiders win!' : 'Imposters win!'
  .round-outcome__reveal
    .text-pair
      span.text-pair__subtitle The word was
      span.text-pair__title.round-outcome__word = round.word
    .text-pair
      span.text-pair__subtitle The imposter hint was
      span.text-pair__title.round-outcome__word = round.imposter_hint
  .round-outcome__imposters
    span.round-outcome__label = round.seats.imposter.size > 1 ? 'The imposters' : 'The imposter'
    - round.seats.imposter.includes(:player).each do |seat|
      span.round-outcome__imposter
        = render 'players/avatar', avatar: seat.avatar, size: :small, label: seat.avatar_label
        = seat.name
